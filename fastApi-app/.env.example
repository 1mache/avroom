# Hugging Face access token for 3D reconstruction (Hunyuan3D / Trellis Spaces).
# Copy this file to `.env` in the same folder and paste your token below.
HF_TOKEN=

# Gemini inpaint-verify. Restrict the key to generativelanguage.googleapis.com
# (AI Studio keys are already restricted). Unrestricted Cloud keys get HTTP 403.
GEMINI_API_KEY=placeholder
# Gemini model id (read on every verify call). 2.0-flash is shut down.
GEMINI_MODEL=gemini-2.5-flash-lite

# Inference worker subprocess count (0 = inline mode with process lock, 2 = two parallel GPU workers).
# Can also be set in the shell before run.bat (PowerShell: $env:INFERENCE_WORKERS=2; ./run.bat).
INFERENCE_WORKERS=0

# Abort inference jobs after INFERENCE_JOB_TIMEOUT_SEC (default 600). Set false to wait until finish.
INFERENCE_JOB_TIMEOUT=true
# INFERENCE_JOB_TIMEOUT_SEC=600
