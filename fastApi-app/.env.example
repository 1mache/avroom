# Hugging Face access token for 3D reconstruction (Hunyuan3D / Trellis Spaces).
# Copy this file to `.env` in the same folder and paste your token below.
HF_TOKEN=

# Gemini inpaint-verify. Restrict the key to generativelanguage.googleapis.com
# (AI Studio keys are already restricted). Unrestricted Cloud keys get HTTP 403.
GEMINI_API_KEY=placeholder
# Gemini model id (read on every verify call). 2.0-flash is shut down.
GEMINI_MODEL=gemini-2.5-flash-lite

# Inference worker subprocess count (0 = inline mode with process lock, 2 = two parallel GPU workers).
# Can also be set in the shell before run.bat (PowerShell: $env:INFERENCE_WORKERS=2; ./run.bat).
INFERENCE_WORKERS=0

# Abort inference jobs after INFERENCE_JOB_TIMEOUT_SEC (default 600). Set false to wait until finish.
INFERENCE_JOB_TIMEOUT=true
# INFERENCE_JOB_TIMEOUT_SEC=600

# --- AWS deployment prep -----------------------------------------------
# Everything below is optional locally; defaults reproduce today's behavior
# exactly (local disk, single fixed dev user, no login, local Postgres).
# See docs/deployment/aws-runbook.md for the full reference.

# "local" (default) or "s3". Uncomment + fill in S3_* to test against a real
# bucket or a local MinIO instance.
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_PREFIX=avroom
# S3_REGION=

# "single_user" (default, no login) or "jwt".
# AUTH_MODE=single_user
# JWT_SECRET=
# JWT_EXPIRE_MINUTES=10080

# Defaults to the docker-compose Postgres service (`docker compose up db`).
# DATABASE_URL=postgresql+psycopg://avroom:avroom@localhost:5433/avroom

# Comma-separated. Defaults to the two local Vite dev origins.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local-disk directory overrides (relative paths resolve against fastApi-app/).
# IMAGE_STORAGE_DIR=tmp/images
# THREED_STORAGE_DIR=tmp/3d
# SCRATCH_DIR=tmp/images

# "disabled" turns off the rotating file log handler (stdout only — use this
# in containers, where CloudWatch already captures stdout).
# LOG_DIR=disabled

# Turns off the AI pipeline's per-stage debug PNG dumps (TestModules/outputs/).
# Leave enabled locally; set to false in containers.
# DEBUG_IMAGE_SAVE=true

# Email notifications when inpainting/3D generation finish (core/notifications/).
# Backend is derived from STORAGE_BACKEND (s3 -> ses, else -> smtp) unless
# overridden here. Local default (Mailpit, via `docker compose up db mailpit`,
# already included in run.bat) needs none of this — mail is viewable at
# http://localhost:8025. AWS default (SES) needs only an IAM role with
# ses:SendEmail; also none of this.
# NOTIFY_ENABLED=true
# NOTIFY_BACKEND=smtp
# NOTIFY_FROM=avroom@avroom.local
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_SES_REGION=
